# --- Book PDFs: never committed, anywhere, under any name -----------------
# Real copyrighted book text. The whole point of this project's design
# (architecture SS2/SS8) is that raw book content never leaves the local
# machine it was extracted on -- pushing it to GitHub (public or private)
# would violate that guarantee outright, not just leak repo size.
/books/
tools/local_extraction/scratch/
tools/local_extraction/**/raw_pdf_text.txt

# --- Secrets ----------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# --- Node / Next.js -------------------------------------------------------
node_modules/
.next/
out/
next-env.d.ts

# --- OS / editor ----------------------------------------------------------
.DS_Store
.vscode/
.idea/
frontend/tsconfig.tsbuildinfo

# Eval harness staging area: raw daily-log text exported straight out of the
# database, before anyone has reviewed it.
backend/eval/cases/staging.jsonl

# eval/cases/golden.jsonl and eval/cassettes/ ARE committed -- a labelled
# golden set and its recorded vectors are only useful if they travel with the
# repo. That is safe only because every case carries redaction='redacted': the
# entry text is an LLM paraphrase (eval/redact.py), not what the visitor
# actually typed. The verbatim originals stay in eval/backups/ below, which is
# not committed. If a verbatim case is ever added back, ignore golden.jsonl
# again until scripts/redact_eval_cases.py has rewritten it.

# Point-in-time dumps taken before a bulk principle rewrite. Reversal data,
# not source: regenerate by running the backup step, don't commit copies.
backend/eval/backups/
